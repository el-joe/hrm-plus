APP_NAME="HRM Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# After rotating APP_KEY, list the old key(s) here (comma-separated) so existing
# encrypted values and sessions can still be read.
# APP_PREVIOUS_KEYS=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrm-plus
DB_USERNAME=root
DB_PASSWORD=

# Operational values (sign-in lockout, mobile token lifetime, session cookie SameSite / Secure,
# security headers / CSP / HSTS, export rate limit, report export thresholds, daily log days)
# are managed in Settings → Security / Reports / Data retention, not here.

# The mobile app uses bearer tokens; stateful (cookie) API domains are not needed.
# SANCTUM_STATEFUL_DOMAINS=
# Optional prefix for issued tokens (helps secret scanners recognise leaked tokens).
# SANCTUM_TOKEN_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_LIFETIME is only the pre-install fallback: Settings → Security decides (as for the
# session cookie's SameSite / Secure flags, managed there too).

# Scramble development tools on the API docs pages (/docs/api). Defaults to
# APP_DEBUG; keep false in production. API_VERSION is shown in the generated docs.
# SCRAMBLE_DEV_TOOLS=false
# API_VERSION=0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
