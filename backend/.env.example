APP_NAME="HRM Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrm-plus
DB_USERNAME=root
DB_PASSWORD=

# Sign-in lockout: failed attempts per email + IP, and lockout length.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60

# Mobile API token lifetime in minutes (43200 = 30 days).
SANCTUM_TOKEN_EXPIRATION=43200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie is marked Secure automatically when APP_URL starts with https://;
# set SESSION_SECURE_COOKIE=true|false only to override that.
# SESSION_SECURE_COOKIE=

# HTTP hardening (config/security.php): security headers, Content-Security-Policy,
# HSTS (sent on HTTPS only) and the export rate limit per user and minute.
SECURITY_HEADERS=true
SECURITY_CSP=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_EXPORTS_PER_MINUTE=20
# Extra origins for images / XHR if files are served from a CDN (comma-separated).
# SECURITY_CSP_IMG_SRC=
# SECURITY_CSP_CONNECT_SRC=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
