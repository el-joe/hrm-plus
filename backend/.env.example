APP_NAME="HRM Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# After rotating APP_KEY, list the old key(s) here (comma-separated) so existing
# encrypted values and sessions can still be read.
# APP_PREVIOUS_KEYS=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Days of files kept by the "daily" log channel.
# LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrm-plus
DB_USERNAME=root
DB_PASSWORD=

# Sign-in lockout: failed attempts per email + IP, and lockout length.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60

# Mobile API token lifetime in minutes (43200 = 30 days).
SANCTUM_TOKEN_EXPIRATION=43200
# The mobile app uses bearer tokens; stateful (cookie) API domains are not needed.
# SANCTUM_STATEFUL_DOMAINS=
# Optional prefix for issued tokens (helps secret scanners recognise leaked tokens).
# SANCTUM_TOKEN_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie is marked Secure automatically when APP_URL starts with https://;
# set SESSION_SECURE_COOKIE=true|false only to override that.
# SESSION_SECURE_COOKIE=
# SameSite policy of the session cookie (lax, strict or none).
# SESSION_SAME_SITE=lax

# HTTP hardening (config/security.php): security headers, Content-Security-Policy,
# HSTS (sent on HTTPS only) and the export rate limit per user and minute.
SECURITY_HEADERS=true
SECURITY_CSP=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_EXPORTS_PER_MINUTE=20
# Extra origins for images / XHR if files are served from a CDN (comma-separated).
# SECURITY_CSP_IMG_SRC=
# SECURITY_CSP_CONNECT_SRC=

# Report centre exports (config/reports.php): exports with more rows than the
# threshold are prepared by the queue worker and announced in the notification centre;
# PDF exports above REPORTS_PDF_MAX_ROWS rows are refused (Excel/CSV have no limit).
REPORTS_QUEUE_THRESHOLD_XLSX=5000
REPORTS_QUEUE_THRESHOLD_CSV=5000
REPORTS_QUEUE_THRESHOLD_PDF=400
REPORTS_PDF_MAX_ROWS=3000

# Scramble development tools on the API docs pages (/docs/api). Defaults to
# APP_DEBUG; keep false in production. API_VERSION is shown in the generated docs.
# SCRAMBLE_DEV_TOOLS=false
# API_VERSION=0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
